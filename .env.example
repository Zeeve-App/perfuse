# All the variable starting with NEXT_PUBLIC are client side variables
# don't store sensetive information here like db config or secrets
NEXT_PUBLIC_HOST="localhost:3000"
NEXT_PUBLIC_BASE_PATH=""
NEXT_PUBLIC_EXPLORER_POLKADOT=

# Can't be access by the client side code, secure variables
SQLITE_DB_LOCATION="./perfuse.sqlite"
JWT_EXPIRES=2 # in hr
JWT_SECRET="secret"
DEFAULT_EMAIL="perfuse@perfuse.io"
DEFAULT_PASS="perfuse@123"
